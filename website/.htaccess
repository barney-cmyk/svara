# Serve DMG files with the correct MIME type so browsers offer "Save as…"
# rather than trying to render them inline as text.
AddType application/x-apple-diskimage .dmg

# Cache rules — static assets can be cached aggressively, HTML should
# revalidate so site updates surface immediately.
<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

<FilesMatch "\.(css|png|jpg|jpeg|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

<FilesMatch "\.dmg$">
    # DMGs MUST NOT cache — every `make ship` overwrites the same
    # `Neuron Flame.dmg` filename with new content, but the bytes have a
    # new EdDSA signature embedded in the matching appcast.xml entry.
    # If the CDN serves stale DMG bytes after the appcast has updated,
    # Sparkle's signature verification rejects the install with:
    #   "EdDSA signature does not match... downloaded archive length
    #    differs from appcast item's length"
    # Previously we had `max-age=86400` here, which caused exactly this
    # bug when we shipped v1.86 → v1.87 → v1.88 in rapid succession.
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Content-Disposition "attachment"
</FilesMatch>

# Sparkle update feed + sitemap — always re-fetch from origin so a freshly
# shipped release surfaces in the in-app "Check for Updates" dialog
# immediately. Sparkle uses NSURLSession with the default protocol cache
# policy, so a cached "you're up to date" response can otherwise stick
# around in the running app's URL cache for hours.
<FilesMatch "^(appcast\.xml|sitemap\.xml|feed\.xml|models\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Pretty 404s
ErrorDocument 404 /404.html
